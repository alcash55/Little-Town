# =====================================================================
# Template for backend/.env.production — REAL production credentials go
# in that file, never in this one. This .example file is committed and
# holds placeholders only.
#
# backend/.env.production is loaded ONLY by `bun run dev:remote`
# (backend/dev-remote.sh), the deliberate, confirmation-gated escape hatch
# for pointing a local backend at the hosted production Supabase project
# and/or the real Discord bot. It is never loaded by the default
# `bun run dev`. See backend/README.md.
#
# Do not set NODE_ENV here — dev-remote.sh keeps it at "development" and
# sets ALLOW_REMOTE_DB=true instead (see backend/src/config/envGuard.ts).
# Setting NODE_ENV=production locally would also disable ALLOW_DEV_AUTH and
# restrict CORS to FRONTEND_URL/CORS_ORIGIN only, breaking local access.
# =====================================================================

ADMIN_EMAIL=admin-account-email
ADMIN_USERNAME=admin-account-username
ADMIN_PASSWORD=admin-account-password
TEST_EMAIL=test-account-email
TEST_PASSWORD=test-account-password
TEST_USERNAME=test-account-username

# JWT Configuration — the real production signing secret.
JWT_SECRET=production-jwt-signing-secret
JWT_EXPIRES_IN=24h

# Supabase — hosted production project.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=production-service-role-key
SUPABASE_PROJECT_REF=<your-project-ref>
SUPABASE_DB_PASSWORD=production-db-password

# Discord — the real shared bot. Also requires DISCORD_ENABLED=true (see
# backend/src/services/discordScreenshots.ts) even when this file is
# loaded — two separate opt-ins are required to touch the real bot.
DISCORD_BOT_TOKEN=production-discord-bot-token
DISCORD_SCREENSHOT_CHANNEL_ID=production-discord-channel-id
