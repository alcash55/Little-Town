{
  "name": "little-town-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://littletown.gay/",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "npm run typecheck && vite build --mode production",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "preview": "VITE_BASEURL=http://localhost:8081 vite build --mode local-preview && vite preview --mode local-preview",
    "preview:remote": "vite build --mode production && vite preview",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "lint": "eslint .",
    "art:bingo": "bun run src/components/Pages/BingoBoard/download-bingo-art.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-charts": "^9.9.0",
    "@mui/x-date-pickers": "9.16.0",
    "date-fns": "^3.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^15",
    "happy-dom": "21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^6.0.2",
    "typescript-native": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
