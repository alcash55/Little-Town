{
  "name": "little-town-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://littletown.gay/",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "tsc && vite build --mode production",
    "preview": "VITE_BASEURL=http://localhost:8081 vite build --mode production && vite preview",
    "preview:remote": "vite build --mode production && vite preview",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "lint": "eslint .",
    "art:bingo": "bun run src/components/Pages/BingoBoard/download-bingo-art.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@fontsource/inter": "^5.0.2",
    "@fontsource/pacifico": "^5.0.2",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-charts": "^9.9.0",
    "@mui/x-date-pickers": "^9.9.0",
    "date-fns": "^3.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^15",
    "happy-dom": "^20.10.6",
    "prettier": "^2.8.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
