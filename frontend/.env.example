# -------------------------------------------------------
# Little Town – Frontend Environment Variables
# Copy this file to .env and fill in the values.
# -------------------------------------------------------

# Base URL for the backend API
# e.g. http://localhost:8081 for local dev, https://api.yourdomain.com for production
VITE_BASEURL=

# -------------------------------------------------------
# .env.production (TEAM-BRIEF.md Sprint 16, Track A item A5)
# -------------------------------------------------------
# frontend/.env.production (gitignored) hardcodes the REAL deployed
# backend's VITE_BASEURL. Vite's default mode for `vite build` (and
# therefore for `bun run preview`, which builds first) is "production", so
# it loads that file automatically. `bun run preview` overrides
# VITE_BASEURL to localhost before building, so it's safe by default — use
# `bun run preview:remote` only when you deliberately want to preview a
# local build talking to the real production API.

# -------------------------------------------------------
# Auth / Role Restrictions
# -------------------------------------------------------
# Auth is controlled by Vite's built-in import.meta.env.DEV flag — no env var needed.
#
# bun dev      → DEV=true  → all pages visible, no role checks (local development)
# bun build    → DEV=false → full role-based auth enforced
# bun preview  → DEV=false → full role-based auth enforced
